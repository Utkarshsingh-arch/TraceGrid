# ==============================================================================
# TraceGrid - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   copy .env.example .env (Windows cmd)
#   cp .env.example .env   (PowerShell / bash)
#
# DO NOT COMMIT REAL CREDENTIALS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Only Configuration (Backend Express API)
# These variables are accessed strictly by the backend process and NEVER exposed
# to the browser client or frontend bundle.
# ------------------------------------------------------------------------------

# Operational Environment: 'development', 'staging', 'production', or 'test'
NODE_ENV=development

# API HTTP Listener Port
PORT=5000

# API Routing Prefix
API_PREFIX=/api

# Permitted CORS Origins (comma-separated for multiple origins, or specific origin)
# In development: http://localhost:5173
# In staging: https://staging.tracegrid.internal or http://localhost:8080
CORS_ORIGIN=http://localhost:5173

# Trusted Reverse Proxy Configuration
# Set to 'true' or 'loopback' if running behind Nginx / Caddy / load balancer.
# Set to 'false' if running standalone directly exposed.
TRUST_PROXY=false

# PostgreSQL Database Connection String
# For local dev container: postgresql://tracegrid_user:tracegrid_password@127.0.0.1:5432/tracegrid_db?schema=public
# For staging container: postgresql://tracegrid_staging_user:STAGING_PASSWORD@postgres:5432/tracegrid_staging_db?schema=public
DATABASE_URL="postgresql://tracegrid_user:tracegrid_password@127.0.0.1:5432/tracegrid_db?schema=public"

# Database Container Configuration (Used by Docker Compose)
POSTGRES_USER=tracegrid_user
POSTGRES_PASSWORD=tracegrid_password
POSTGRES_DB=tracegrid_db
POSTGRES_PORT=5432

# Authentication & Session Security (JWT)
# IMPORTANT: In staging and production, JWT_SECRET MUST be a cryptographically
# secure random string of at least 32 characters (e.g. generated via `openssl rand -hex 32`).
# Values containing 'tracegrid-dev', 'insecure', or 'default' will fail startup validation.
JWT_SECRET=tracegrid-dev-local-secret-key-32charsmin!
JWT_EXPIRES_IN=8h

# Evidence & Private File Storage
# Directory where uploaded binary evidence files are stored (isolated from web root)
STORAGE_LOCAL_PATH=./storage/evidence

# Token Revocation Store Path (Optional override; defaults to ./storage/revoked_tokens.json)
STORAGE_REVOCATION_PATH=./storage/revoked_tokens.json

# Maximum Attachment Upload Size in Bytes (10485760 = 10 MB)
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Vite Web Client)
# Only variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER place database credentials, API secrets, or private keys in VITE_ variables!
# ------------------------------------------------------------------------------

# Frontend API Base URL
# By default, leave empty or set to '/api' so requests route via the local Vite dev proxy
# or Nginx reverse proxy on the same origin (avoids CORS and hardcoded localhost URLs).
# Set to an absolute URL ONLY if hosting the frontend on a separate domain/subdomain.
VITE_API_BASE_URL=/api

# Optional Map Tile Provider Settings (Defaults to standard HTTPS OpenStreetMap raster tiles)
# Never put secret credentials or private API keys in VITE_ frontend variables.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>'
